rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isLinkedPlayer(playerTagId) {
      return isSignedIn()
        && userDoc().data.playerTagId == playerTagId;
    }

    // User profile — read own doc only; writes via Cloud Functions (Admin SDK)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Cached player profiles — readable only for the linked player
    match /players/{playerTagId} {
      allow read: if isLinkedPlayer(playerTagId);
      allow create, update, delete: if false;

      match /battleLogs/{battleId} {
        allow read: if isLinkedPlayer(playerTagId);
        allow create, update, delete: if false;
      }

      match /upcomingChests/{docId} {
        allow read: if isLinkedPlayer(playerTagId);
        allow create, update, delete: if false;
      }
    }

    // Clan cache — readable only when linked to the same player tag context
    match /clans/{clanTagId} {
      allow read: if isSignedIn()
        && userDoc().data.playerTagId != null;
      allow create, update, delete: if false;
    }

    // Global cards cache — read-only for authenticated users
    match /cards/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Sync metadata — server-managed only
    match /syncMetadata/{playerTagId} {
      allow read: if isLinkedPlayer(playerTagId);
      allow create, update, delete: if false;
    }
  }
}
